APP_NAME=QA Automation
APP_ENV=development

DATABASE_URL=postgresql+psycopg://qa_user:qa_password@localhost:5432/qa_automation

# Paths are relative to the backend/ working directory (where uvicorn runs from)
AUDIO_STORAGE_PATH=../data/audio
TRANSCRIPT_STORAGE_PATH=../data/transcripts

API_PREFIX=/api/v1
