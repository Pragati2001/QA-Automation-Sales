# Copy to .env for local development: cp .env.example .env
# On Render there is no .env file: set these as Environment Variables in the dashboard instead.
# Never commit real credentials. This file only ever holds placeholders.

# --- REQUIRED --------------------------------------------------------------------------------
# The only variable the app cannot start without.
# Local: the Postgres from docker-compose.yml (or your own).
# Render: paste the Internal Database URL of your Render Postgres. postgres:// and postgresql://
# are accepted and rewritten to postgresql+psycopg:// automatically; this is the form to use elsewhere.
DATABASE_URL=postgresql+psycopg://qa_user:qa_password@localhost:5432/qa_automation

# --- OPTIONAL (defaults shown) -----------------------------------------------------------------
APP_NAME=QA Automation
APP_ENV=development
API_PREFIX=/api/v1

# Where recordings and transcripts are stored; the directories are created automatically.
# Default if unset: /tmp/audio and /tmp/transcripts. On Render /tmp is EPHEMERAL (lost on restart
# and on every deploy), so uploaded recordings disappear. For durable storage attach a Render
# Disk and point AUDIO_STORAGE_PATH at its mount path, e.g. /var/data/audio.
# The values below are for local development (relative to backend/, where uvicorn runs from).
AUDIO_STORAGE_PATH=../data/audio
TRANSCRIPT_STORAGE_PATH=../data/transcripts

# Browser origins allowed to call the API directly, as a JSON list. Only needed when the frontend
# runs on a different origin and calls this API by absolute URL (VITE_API_BASE).
# Default: the Vite dev server. On Render, set it to your deployed frontend's URL, for example:
# CORS_ORIGINS=["https://your-frontend.onrender.com"]

# --- SET BY THE HOST, NOT READ FROM THIS FILE ---------------------------------------------------
# PORT             Render provides it; use it in the start command: --port $PORT
# PYTHON_VERSION   Render environment variable choosing the Python version (the code needs 3.10+).
